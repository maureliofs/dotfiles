[global]
    ### Layout e Geometria ###
    # Largura fixa e altura dinâmica (comum para não ocupar a tela toda)
    width = 300
    height = 200
    origin = top-right
    offset = 20x50
    
    # Espaçamento interno (mais respiro para o texto)
    padding = 15
    horizontal_padding = 15
    frame_width = 2
    
    # Cantos arredondados (Requer um compositor como Picom)
    corner_radius = 8

    ### Texto e Fonte ###
    font = JetBrains Mono 10
    line_height = 4
    markup = yes
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle

    ### Comportamento ###
    # Segue o mouse para a notificação aparecer onde você está olhando
    follow = mouse
    
    # Não empilha infinitamente (mantém a tela limpa)
    indicate_hidden = yes
    stack_duplicates = true
    hide_duplicate_count = false
    
    # Ícones
    icon_position = left
    max_icon_size = 48
    
    # Histórico e Atalhos
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/brave

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave

[urgency_low]
    # One Dark Colors
    background = "#282c34"
    foreground = "#abb2bf"
    frame_color = "#3e4451"
    timeout = 4

[urgency_normal]
    background = "#282c34"
    foreground = "#abb2bf"
    frame_color = "#61afef"
    timeout = 8

[urgency_critical]
    background = "#282c34"
    foreground = "#e06c75"
    frame_color = "#e06c75"
    timeout = 0